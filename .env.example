# Google Places API – für Kundenbewertungen auf der Startseite
# Place ID finden: Google Maps → Ihr Eintrag → Teilen → Link kopieren
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Optional: Cloud Translation API – übersetzt Bewertungstexte und Zeitangaben auf Deutsch.
# Kann derselbe Key wie GOOGLE_PLACES_API_KEY sein.
GOOGLE_TRANSLATE_API_KEY=
