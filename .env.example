# Google Places API – für Kundenbewertungen auf der Startseite
# Place ID finden: Google Maps → Ihr Eintrag → Teilen → Link kopieren
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Optional: Cloud Translation API – übersetzt Bewertungstexte und Zeitangaben auf Deutsch.
# Kann derselbe Key wie GOOGLE_PLACES_API_KEY sein.
GOOGLE_TRANSLATE_API_KEY=

# Kontaktformular – SMTP (aktuell in Vercel genutzt)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Empfänger, falls abweichend vom SMTP-Konto
CONTACT_TO_EMAIL=

# Alternative: Resend statt SMTP
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=

# Analytics (bestehende Live-IDs). Werden nur auf Vercel Production nach Consent geladen.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-2F2YJSZXG5
# NEXT_PUBLIC_PIRSCH_CODE=vJWT37N3h190aNHNNLe4ZWy9zexmJm6H
